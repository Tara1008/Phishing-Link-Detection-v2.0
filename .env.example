# ================================================================
# PhishGuard AI - Root Environment Configuration
# ================================================================

# Server Port (Railway automatically sets PORT)
PORT=3001
NODE_ENV=production

# MySQL Configuration (Optional - falls back to data/scans.json if omitted)
# MYSQL_URL=mysql://root:password@containers.railway.app:3306/railway
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=phishguard

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
