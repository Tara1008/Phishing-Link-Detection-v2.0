# ================================================================
# PhishGuard AI - Environment Configuration
# ================================================================
# NOTE: The application is fully flexible!
# If NO database variables are provided, it automatically uses the
# built-in local persistent store (data/scans.json).
# ================================================================

# Server Port (Railway will automatically set PORT in production)
PORT=3001
NODE_ENV=production

# ----------------------------------------------------------------
# Option A: MySQL Connection URL (Used automatically by Railway)
# ----------------------------------------------------------------
# MYSQL_URL=mysql://root:password@containers.railway.app:3306/railway
# DATABASE_URL=mysql://root:password@containers.railway.app:3306/railway

# ----------------------------------------------------------------
# Option B: Individual MySQL Parameters (Local instance)
# ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=phishguard

# ----------------------------------------------------------------
# CORS & Security (Optional)
# In production single-service deployment, the backend automatically
# serves the frontend static build, so FRONTEND_URL is not required.
# ----------------------------------------------------------------
# FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
